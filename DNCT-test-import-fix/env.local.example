# Đổi tên file này thành .env.local rồi điền thông tin lấy từ Supabase
# Settings -> API trong dự án Supabase của bạn

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mật khẩu để vào trang Lịch sử / Báo cáo (KHÔNG có tiền tố NEXT_PUBLIC_
# nên sẽ không bị lộ ra trình duyệt của người dùng)
ADMIN_PASSWORD=doi-thanh-mat-khau-cua-ban

# (Không bắt buộc) Giới hạn thời gian cho phép làm bài.
# Định dạng ISO, có múi giờ +07:00 cho Việt Nam. Xoá dòng nào không cần dùng.
# NEXT_PUBLIC_QUIZ_START=2026-08-05T08:00:00+07:00
# NEXT_PUBLIC_QUIZ_DEADLINE=2026-08-10T17:00:00+07:00
